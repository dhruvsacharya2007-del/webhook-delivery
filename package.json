{
  "name": "webhook-delivery-service",
  "version": "1.0.0",
  "description": "A reliable webhook delivery service",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "deliver:once": "node --env-file-if-exists=.env scripts/deliverOnce.js",
    "worker": "node --env-file-if-exists=.env src/worker.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "6.15.0",
    "prisma": "6.15.0",
    "express": "^5.2.1",
    "fast-json-stable-stringify": "^2.1.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2"
  }
}